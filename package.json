{
  "name": "gamestudio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "engine": "node engine/cli/dist/main.js",
    "doctor": "pnpm --filter @gamestudio/cli build && node engine/cli/dist/main.js doctor",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:timing": "vitest run --config vitest.timing.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise engine web --config .dependency-cruiser.cjs",
    "check:scripts": "python scripts/check-python-syntax.py scripts/check-python-syntax.py .claude/skills/threejs-image-generator/scripts/generate_image.py .claude/skills/threejs-audio-generator/scripts/threejs_audio_asset.py",
    "test:helpers": "python -B -m unittest discover -s scripts/tests -p test_*.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
