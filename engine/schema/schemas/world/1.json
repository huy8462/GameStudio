{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio.local/schema/world/1.json",
  "title": "world.json (SCH-GEN-02, SCH-WLD-01, SRS-02 Â§6.1, DDD-02 DTO-WLD-01)",
  "type": "object",
  "required": ["schemaVersion", "seed", "source", "playArea", "zones", "timeOfDay", "postFx"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "seed": { "$ref": "../common/1.json#/$defs/seed" },
    "source": { "enum": ["real", "procedural", "mixed"] },
    "origin": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "utmZone": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "bbox": {
      "type": "object",
      "required": ["south", "west", "north", "east"],
      "additionalProperties": false,
      "properties": {
        "south": { "type": "number", "minimum": -90, "maximum": 90 },
        "west": { "type": "number", "minimum": -180, "maximum": 180 },
        "north": { "type": "number", "minimum": -90, "maximum": 90 },
        "east": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "procedural": { "$ref": "defs-1.json#/$defs/procedural" },
    "blendMask": { "type": "string" },
    "heightScale": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
    "smoothing": { "type": "number", "minimum": 0, "default": 0 },
    "erosion": { "$ref": "defs-1.json#/$defs/erosion" },
    "playArea": { "$ref": "../common/1.json#/$defs/polygon" },
    "zones": { "type": "array", "minItems": 1, "items": { "$ref": "defs-1.json#/$defs/zone" } },
    "water": { "type": "array", "items": { "$ref": "defs-1.json#/$defs/water" } },
    "vegetation": { "type": "array", "items": { "$ref": "defs-1.json#/$defs/vegLayer" } },
    "placementRules": { "type": "array", "items": { "$ref": "defs-1.json#/$defs/placementRule" } },
    "placedObjects": { "type": "array", "items": { "$ref": "defs-1.json#/$defs/placedObject" } },
    "regions": { "type": "array", "items": { "$ref": "defs-1.json#/$defs/region" } },
    "timeOfDay": { "type": "array", "minItems": 1, "items": { "$ref": "defs-1.json#/$defs/timeOfDay" } },
    "dayNightCycle": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minutesPerDay": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fog": { "type": "object" },
        "clouds": { "type": "object" },
        "rain": { "type": "object" },
        "mist": { "type": "object" }
      }
    },
    "postFx": {
      "type": "object",
      "required": ["toneMapping"],
      "additionalProperties": false,
      "properties": {
        "toneMapping": { "enum": ["aces", "agx"] },
        "bloom": { "oneOf": [{ "type": "boolean" }, { "type": "object" }] },
        "lut": { "$ref": "../common/1.json#/$defs/assetRef" },
        "colorGrade": { "type": "object" }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "wind": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "spawns": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Äáº·c táº£ chi tiáº¿t á»Ÿ DDD-05 (E6)"
    },
    "ambience": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Äáº·c táº£ chi tiáº¿t á»Ÿ DDD-03 (E6)"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "enum": ["real", "mixed"] } } },
      "then": { "required": ["origin", "bbox"] }
    },
    {
      "if": { "properties": { "source": { "enum": ["procedural", "mixed"] } } },
      "then": { "required": ["procedural"] }
    },
    {
      "if": { "properties": { "source": { "const": "mixed" } } },
      "then": { "required": ["blendMask"] }
    }
  ]
}
