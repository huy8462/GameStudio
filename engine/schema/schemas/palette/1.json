{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio.local/schema/palette/1.json",
  "title": "palette.json (SCH-GEN-03, BR-05.2: 8–16 màu chính có vai trò)",
  "type": "object",
  "required": ["schemaVersion", "colors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "status": {
      "enum": ["ChuaCo", "ChoDuyet", "DaDuyet"],
      "default": "ChoDuyet",
      "description": "Theo style bible (FR-INT-20…22)"
    },
    "colors": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "hex", "role"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "role": { "enum": ["nen", "nhan", "ui", "anh_sang"], "description": "nền, nhấn, UI, ánh sáng (BR-05.2)" },
          "name": { "type": "string", "maxLength": 60 },
          "usage": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
