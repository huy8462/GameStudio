{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamestudio.local/schema/intake/brief/1.json",
  "title": "brief.json (SCH-INT-04, DTO-INT-06; khoá SRS-01 §6.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "sourceRef",
    "genre",
    "camera",
    "setting",
    "artStyle",
    "coreLoop",
    "player",
    "npcs",
    "animals",
    "features",
    "scale",
    "highRiskAssets",
    "assumptions",
    "suggestions"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sourceRef": { "type": "string", "pattern": "^(intake|reverse):[A-Za-z0-9_-]+$" },
    "genre": { "type": "string", "minLength": 1 },
    "camera": { "enum": ["first_person", "third_person"] },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["place", "era", "season", "timeOfDay", "realPlace"],
      "properties": {
        "place": { "type": "string", "minLength": 1 },
        "era": { "type": "string", "minLength": 1 },
        "season": { "type": "string", "minLength": 1 },
        "timeOfDay": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "realPlace": { "type": "boolean" }
      }
    },
    "artStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "refs"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coreLoop": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
    "player": { "type": "string", "minLength": 1 },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "count"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "animals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["species", "count"],
        "properties": {
          "species": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "temperament": { "type": "string" }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combat", "hunting", "dialogueMode"],
      "properties": {
        "combat": { "type": "boolean" },
        "hunting": { "type": "boolean" },
        "dialogueMode": { "enum": ["static", "ai", "hybrid"] }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zones", "areaKm2"],
      "properties": {
        "zones": { "type": "integer", "minimum": 1 },
        "areaKm2": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
      }
    },
    "highRiskAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset", "level", "approach"],
        "properties": {
          "asset": { "type": "string", "minLength": 1 },
          "level": { "enum": ["Cao", "Vua"] },
          "approach": { "enum": ["cc0_truoc", "generator", "duyet_2_vong"] }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "reason"],
        "properties": { "field": { "type": "string" }, "value": {}, "reason": { "type": "string" } }
      }
    },
    "suggestions": { "type": "array", "items": { "type": "string" } }
  }
}
