{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/h01-large-md.mjs"],
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/h02-binary-log.mjs"],
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/h04-secrets.mjs"],
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/h04-secrets.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/h03-schema.mjs"],
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/h05-perf.mjs"],
            "timeout": 2
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(**/.env)", "Read(**/.env.*)", "Read(**/*.pem)", "Read(**/*.key)", "Read(**/secrets/**)"],
    "allow": [
      "Read(**/.env.example)",
      "Bash(pnpm engine *)",
      "Bash(pnpm doctor)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm depcruise)",
      "Bash(pnpm format:check)",
      "Bash(node engine/cli/dist/main.js *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
